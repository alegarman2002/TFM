<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- GPS -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- SMS -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Vibración para feedback háptico (R2.2) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Internet (Wearable API + Geocoder) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Foreground Service para mantener viva la monitorización en background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Notificaciones (API 33+ runtime, anteriores permiso normal) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Full-Screen Intent para abrir la pre-alerta a pantalla completa -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Wake-lock para procesado inmediato tras detección -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:testOnly="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WearableListenerService — escucha dos paths distintos -->
        <service
            android:name=".WearableMessageReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/sensor_data" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/cancel_alert" />
            </intent-filter>
        </service>

        <!-- Foreground Service de monitorización persistente -->
        <service
            android:name=".MonitoringService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>